<resources>

    <!-- Bento theme; bars painted with the surface colour by EdgeToEdgeInsets. -->
    <style name="AppTheme" parent="Theme.Bento">
        <item name="android:statusBarColor">@color/bento_surface</item>
        <item name="android:navigationBarColor">@color/bento_surface</item>
        <item name="android:windowLightStatusBar">@bool/bento_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/bento_light_bars</item>
    </style>
    <style name="MyDialogStyle" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorBackground">#ffffff</item>
        <item name="android:textColor">#221f35</item>
    </style>
    <!-- Game board: black bars around the full-bleed tiles; dialogs still use the Bento colours. -->
    <style name="AppTheme.Game">
        <item name="android:statusBarColor">#0A0A0A</item>
        <item name="android:navigationBarColor">#0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
