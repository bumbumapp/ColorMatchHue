<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context="com.bumbumapps.hue.MainMenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting_evening"
                    android:textAppearance="@style/Bento.Text.Greeting" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_title"
                    android:textAppearance="@style/Bento.Text.Display" />
            </LinearLayout>

            <!-- Coins pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bento_icon_square"
                android:backgroundTint="?attr/colorSurfaceContainerLowest"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/coins_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAppearance="@style/Bento.Text.TitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/coin"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/coins"
                    app:srcCompat="@drawable/coins" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero: start playing -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/main_menu_start_game"
            style="@style/Bento.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:contentDescription="@string/start_game">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <View
                    android:id="@+id/hero_strip"
                    android:layout_width="150dp"
                    android:layout_height="44dp"
                    android:background="@drawable/hue_strip" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bento_hero_circle"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_b_play" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/hero_strip"
                    android:layout_marginTop="18dp"
                    android:text="@string/start_game"
                    android:textAppearance="@style/Bento.Text.Hero" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/hero_title"
                    android:layout_marginTop="4dp"
                    android:text="@string/hero_sub"
                    android:textAppearance="@style/Bento.Text.HeroSub" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/section_levels"
            android:textAppearance="@style/Bento.Text.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/tile_easy"
                layout="@layout/item_level_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tile_medium"
                layout="@layout/item_level_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/tile_expert"
                layout="@layout/item_level_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- How to play -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/main_menu_how_to"
            style="@style/Bento.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bento_icon_square"
                    android:backgroundTint="@color/bento_tile_blue_bg"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_b_help"
                    app:tint="@color/bento_tile_blue_fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/how_to_play"
                        android:textAppearance="@style/Bento.Text.TileLabel" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/how_to_sub"
                        android:textAppearance="@style/Bento.Text.BodySmall" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/main_menu_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/privacy_options"
            android:textAppearance="@style/Bento.Text.BodySmall"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
