<?xml version="1.0" encoding="utf-8"?>
<!-- Hint dialog: spend 5 coins (or watch a video) to place one tile correctly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bento_dialog_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/coins"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/coins" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/hint_title"
        android:textAppearance="@style/Bento.Text.TitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/hint_body"
        android:textAppearance="@style/Bento.Text.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <Button
        android:id="@+id/spend_btn"
        style="@style/Bento.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/hint_spend" />

    <Button
        android:id="@+id/reward_btn"
        style="@style/Bento.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:text="@string/hint_video" />

    <TextView
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingHorizontal="24dp"
        android:text="@string/hint_cancel"
        android:textAppearance="@style/Bento.Text.TitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
